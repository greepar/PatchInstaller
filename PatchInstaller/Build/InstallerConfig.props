<Project>
  <PropertyGroup>
    <!-- 程序标题 -->
    <InstallerName>PatchInstaller</InstallerName>

    <!-- 默认补丁下载链接，可留空 -->
    <DefaultPatchUrl>主源|https://example.com/patch/latest.zip;镜像源|https://mirror.example.com/patch/latest.zip</DefaultPatchUrl>

    <!-- 自动识别本地补丁时的文件名前缀 -->
    <PatchFilePrefix>Patch</PatchFilePrefix>

    <!-- Steam 游戏目录名，用于自动定位 -->
    <SteamGameFolderName>YourSteamGameFolder</SteamGameFolderName>
  </PropertyGroup>
</Project>
