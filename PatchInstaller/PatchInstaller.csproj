<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>13</LangVersion>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PublishSingleFile>true</PublishSingleFile>
        <Version>1.2.3</Version>
        <FileVersion>1.2.3.0</FileVersion>
        <AssemblyVersion>1.2.3.0</AssemblyVersion>
        <InformationalVersion>1.2.3</InformationalVersion>
        <Authors>greepar</Authors>
        <Company>greepar</Company>
        <Product>$(InstallerProductName)</Product>
    </PropertyGroup>

    <PropertyGroup Label="ApplicationConfiguration">
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\avalonia-logo.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Label="AvaloniaConfiguration">
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <Import Project="Build\InstallerConfig.props" />
    
    <!--    Aot publish-->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <SelfContained>true</SelfContained>
        <PublishTrimmed>true</PublishTrimmed>
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="HotAvalonia" Version="3.1.4" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="LightDl" Version="0.4.3" />

        <PackageReference Include="StaticLink.Avalonia" Version="3.119.2-7151.12" />
        <PackageReference Include="StaticLink.Avalonia.Native" Version="11.3.14.1" />
        <PackageReference Include="Avalonia" Version="11.3.14" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.14" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="SharpCompress" Version="0.50.4" />
        <PackageReference Include="SukiUI" Version="6.0.4-nightly20260507" />
    </ItemGroup>
    
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>InstallerName</_Parameter1>
            <_Parameter2>$(InstallerName)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>DefaultPatchUrl</_Parameter1>
            <_Parameter2>$(DefaultPatchUrl)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>PatchFilePrefix</_Parameter1>
            <_Parameter2>$(PatchFilePrefix)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>SteamGameFolderName</_Parameter1>
            <_Parameter2>$(SteamGameFolderName)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>CheckUpdateApi</_Parameter1>
            <_Parameter2>$(CheckUpdateApi)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
    
    <ItemGroup>
      <Folder Include="Assets\Fonts\" />
    </ItemGroup>
</Project>
