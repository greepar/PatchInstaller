<sukiUi:SukiWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                   xmlns:patchInstaller="clr-namespace:PatchInstaller"
                   x:Class="PatchInstaller.MainWindow"
                   x:DataType="patchInstaller:MainWindowViewModel"
                   WindowStartupLocation="CenterScreen"
                   Width="900"
                   Height="550"
                   CanResize="False"
                   CanMinimize="True"
                   Title="Patch Installer">

    <sukiUi:SukiWindow.Hosts>
        <sukiUi:SukiDialogHost Name="DialogHost" />
    </sukiUi:SukiWindow.Hosts>

    <Design.DataContext>
        <patchInstaller:MainWindowViewModel />
    </Design.DataContext>

    <Grid>
    <Border Name="MainContent" Padding="24 24 24 12" Opacity="0" IsHitTestVisible="False">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock FontSize="28"
                               FontWeight="Bold"
                               Text="{Binding ProductName}" />
                    <TextBlock Text="{Binding SubtitleText}" />
                </StackPanel>

                <Button Grid.Column="1"
                        CornerRadius="12"
                        Padding="7"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="OpenProjectGithub"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28"
                                Height="28"
                                CornerRadius="14"
                                BorderThickness="1">
                            <Viewbox Width="16"
                                     Height="16"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M10.303 16.652c-2.837-.344-4.835-2.385-4.835-5.028 0-1.074.387-2.235 1.031-3.008-.279-.709-.236-2.214.086-2.837.86-.107 2.02.344 2.708.967.816-.258 1.676-.386 2.728-.386 1.053 0 1.913.128 2.686.365.666-.602 1.848-1.053 2.708-.946.3.581.344 2.085.064 2.815.688.817 1.053 1.913 1.053 3.03 0 2.643-1.998 4.641-4.877 5.006.73.473 1.224 1.504 1.224 2.686v2.235c0 .644.537 1.01 1.182.752 3.889-1.483 6.94-5.372 6.94-10.185 0-6.081-4.942-11.044-11.022-11.044-6.081 0-10.98 4.963-10.98 11.044a10.84 10.84 0 0 0 7.112 10.206c.58.215 1.139-.172 1.139-.752v-1.719a2.768 2.768 0 0 1-1.032.215c-1.418 0-2.256-.773-2.857-2.213-.237-.58-.495-.924-.989-.988-.258-.022-.344-.129-.344-.258 0-.258.43-.451.86-.451.623 0 1.16.386 1.719 1.181.43.623.881.903 1.418.903.537 0 .881-.194 1.375-.688.365-.365.645-.687.903-.902Z" />
                            </Viewbox>
                        </Border>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="/ PatchInstaller" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1" Padding="18" CornerRadius="14">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="Auto,*" ColumnSpacing="0">
                        <ComboBox Grid.Column="0"
                                  Margin="-10 0 0 0"
                                  IsEnabled="{Binding CanInstall}"
                                  SelectedItem="{Binding SelectedPatchSourceOption}"
                                  ItemsSource="{Binding PatchSourceOptions}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid Grid.Column="1"
                              IsVisible="{Binding UseRemoteSource}"
                              ColumnDefinitions="*,130"
                              ColumnSpacing="12">
                            <Grid Grid.Column="0">
                                <TextBox IsVisible="{Binding ShowDownloadUrlInput}"
                                          IsEnabled="{Binding CanInstall}"
                                          Watermark="{Binding DownloadUrlWatermarkText}"
                                          Text="{Binding PatchUrl}" />
                                <Border IsVisible="{Binding ShowBuiltInSourceSelector}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Padding="16,10"
                                        CornerRadius="14"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <RadioButton GroupName="BuiltInPatchSources"
                                                     VerticalAlignment="Center"
                                                     IsChecked="{Binding IsAutoBuiltInSourceSelected}">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding AutoText}" />
                                        </RadioButton>
                                        <ItemsControl ItemsSource="{Binding BuiltInDownloadOptions}"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                     <RadioButton GroupName="BuiltInPatchSources"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0"
                                                                  PointerEntered="ProbeBuiltInSource">
                                                        <RadioButton.IsChecked>
                                                            <Binding Path="IsSelected" />
                                                        </RadioButton.IsChecked>
                                                        <ToolTip.Tip>
                                                            <StackPanel MaxWidth="420" Spacing="4">
                                                                <TextBlock TextWrapping="Wrap"
                                                                           Text="{Binding ProbeTooltip}" />
                                                                <TextBlock Opacity="0.72"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding ProbeTooltipStatus}" />
                                                            </StackPanel>
                                                        </ToolTip.Tip>
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding Name}" />
                                                    </RadioButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Button Grid.Column="1"
                                    Width="130"
                                    IsEnabled="{Binding CanInstall}"
                                    Command="{Binding InstallCommand}"
                                    Content="{Binding InstallText}" />
                        </Grid>

                        <Grid Grid.Column="1"
                              IsVisible="{Binding UseLocalSource}"
                              ColumnDefinitions="*,130,130"
                              ColumnSpacing="12">
                            <TextBox Grid.Column="0"
                                     IsEnabled="{Binding CanInstall}"
                                     Watermark="{Binding PatchWatermarkText}"
                                     Text="{Binding LocalPatchPath}" />
                            <Button Grid.Column="1"

                                    Width="130"
                                    IsEnabled="{Binding CanInstall}"
                                    Click="ManualSelectPatch"
                                    Content="{Binding SelectPatchText}" />
                            <Button Grid.Column="2"
                                    IsVisible="{Binding ShowLocalInstallButton}"

                                    Width="130"
                                    IsEnabled="{Binding CanInstall}"
                                    Command="{Binding InstallCommand}"
                                    Content="{Binding InstallText}" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"

                                   Text="{Binding GamePathText}" />
                        <TextBox Grid.Column="1"
                                 Watermark="{Binding GamePathWatermarkText}"
                                 IsEnabled="{Binding CanInstall}"
                                 Text="{Binding GamePath}" />
                        <Button Grid.Column="2"

                                Width="130"
                                IsEnabled="{Binding CanInstall}"
                                Click="ManualLocateGamePath"
                                Content="{Binding LocateText}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="18,18,18,32" CornerRadius="14">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Bottom"
                                   Text="{Binding InstallProgressText}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="{Binding DownloadText}" />
                        <Button Grid.Column="2"
                                IsVisible="{Binding CanCancelInstall}"
                                Command="{Binding CancelInstallCommand}"
                                Content="{Binding CancelDownloadText}" />
                        <Button Grid.Column="3"
                                Width="1" MinWidth="1"
                                IsVisible="True"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Content="占位" />
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 Height="12"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding DownloadProgress}" />

                    <TextBlock Grid.Row="2"
                               Text="{Binding DownloadSpeedText}" />

                    <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <sukiUi:GlassCard Padding="14"
                                          Classes.Primary="{Binding IsStep1Active}"
                                          Classes.Accent="{Binding IsStep1Completed}">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold"
                                           Opacity="0.75"
                                           Text="{Binding LocateGameText}" />
                                <Separator />
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="{Binding Step1Status}" />
                            </StackPanel>
                        </sukiUi:GlassCard>
                        <sukiUi:GlassCard Grid.Column="1"
                                          Padding="14"
                                          Classes.Primary="{Binding IsStep2Active}"
                                          Classes.Accent="{Binding IsStep2Completed}">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold"
                                           Opacity="0.75"
                                           Text="{Binding GetPatchText}" />
                                <Separator />
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="{Binding Step2Status}" />
                            </StackPanel>
                        </sukiUi:GlassCard>
                        <sukiUi:GlassCard Grid.Column="2"
                                          Padding="14"
                                          Classes.Primary="{Binding IsStep3Active}"
                                          Classes.Accent="{Binding IsStep3Completed}">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold"
                                           Opacity="0.75"
                                           Text="{Binding ExtractInstallText}" />
                                <Separator />
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="{Binding Step3Status}" />
                            </StackPanel>
                        </sukiUi:GlassCard>
                    </Grid>

                </Grid>
            </Border>

            <TextBlock Grid.Row="2" Margin="0 0 0 0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       PointerPressed="VersionTextPointerPressed"
                       Text="{Binding DisplayVersion, StringFormat='© greepar · v{0}'}" />
        </Grid>
    </Border>

    <Border Name="LanguageOverlay"
            Background="Transparent"
            IsHitTestVisible="True"
            Opacity="1">
        <StackPanel Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="18">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="28"
                       FontWeight="Bold"
                       Text="选择语言 / Select language" />
            <ComboBox Width="300"
                      Name="LanguageComboBox"
                      MinHeight="52"
                      HorizontalAlignment="Center"
                      HorizontalContentAlignment="Center"
                      Padding="16,0"
                      PlaceholderText="请选择 / Choose">
                <ComboBoxItem HorizontalContentAlignment="Center" Content="简体中文" />
                <ComboBoxItem HorizontalContentAlignment="Center" Content="繁體中文" />
                <ComboBoxItem HorizontalContentAlignment="Center" Content="English" />
            </ComboBox>
            <Button MinWidth="132"
                    MinHeight="38"
                    Padding="22,0"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Click="ConfirmLanguageSelection"
                    Content="下一步 / Next" />
        </StackPanel>
    </Border>
    </Grid>
</sukiUi:SukiWindow>
