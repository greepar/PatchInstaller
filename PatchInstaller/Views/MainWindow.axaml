<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="using:Avalonia_NativeAOT_SingleFile.ViewModels"
        x:Class="Avalonia_NativeAOT_SingleFile.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        mc:Ignorable="d"
        d:DesignWidth="980"
        d:DesignHeight="760"
        Width="980"
        Height="760"
        CanResize="False">
    <Window.Styles>
        <Style Selector="Button.action-button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.action-button:pointerover">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.action-button:pointerover /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.action-button:pressed">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.action-button:pressed /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.action-button:disabled">
            <Setter Property="Foreground" Value="#E5E7EB" />
        </Style>
        <Style Selector="Button.action-button:disabled /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="#E5E7EB" />
        </Style>
        <Style Selector="SelectableTextBlock.log-entry">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="SelectableTextBlock.log-entry:pointerover">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <viewModels:MainWindowViewModel />
    </Design.DataContext>

    <Border Padding="24" Background="#111827">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="{Binding ProductName}" />
                    <TextBlock Foreground="#D1D5DB"
                               Text="支持从链接下载，或直接使用本地 zip / rar / 7z 补丁包进行安装。" />
                </StackPanel>

                <Button Grid.Column="1"
                        Classes="action-button"
                        CornerRadius="12"
                        Padding="7"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="OpenProjectGithub"
                        Background="#0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28"
                                Height="28"
                                CornerRadius="14"
                                Background="#111827"

                                BorderThickness="1">
                            <Viewbox Width="16"
                                     Height="16"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path Fill="White"
                                      Data="M10.303 16.652c-2.837-.344-4.835-2.385-4.835-5.028 0-1.074.387-2.235 1.031-3.008-.279-.709-.236-2.214.086-2.837.86-.107 2.02.344 2.708.967.816-.258 1.676-.386 2.728-.386 1.053 0 1.913.128 2.686.365.666-.602 1.848-1.053 2.708-.946.3.581.344 2.085.064 2.815.688.817 1.053 1.913 1.053 3.03 0 2.643-1.998 4.641-4.877 5.006.73.473 1.224 1.504 1.224 2.686v2.235c0 .644.537 1.01 1.182.752 3.889-1.483 6.94-5.372 6.94-10.185 0-6.081-4.942-11.044-11.022-11.044-6.081 0-10.98 4.963-10.98 11.044a10.84 10.84 0 0 0 7.112 10.206c.58.215 1.139-.172 1.139-.752v-1.719a2.768 2.768 0 0 1-1.032.215c-1.418 0-2.256-.773-2.857-2.213-.237-.58-.495-.924-.989-.988-.258-.022-.344-.129-.344-.258 0-.258.43-.451.86-.451.623 0 1.16.386 1.719 1.181.43.623.881.903 1.418.903.537 0 .881-.194 1.375-.688.365-.365.645-.687.903-.902Z" />
                            </Viewbox>
                        </Border>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="/ PatchInstaller" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1" Padding="18" Background="#1F2937" CornerRadius="14">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="110,*" ColumnSpacing="12">
                        <ComboBox Grid.Column="0"
                                  IsEnabled="{Binding CanInstall}"
                                  SelectedItem="{Binding SelectedPatchSource}"
                                  ItemsSource="{Binding PatchSourceOptions}" />

                        <Grid Grid.Column="1"
                              IsVisible="{Binding UseDownloadSource}"
                              ColumnDefinitions="*,130"
                              ColumnSpacing="12">
                            <TextBox Grid.Column="0"
                                     IsEnabled="{Binding CanInstall}"
                                     Text="{Binding PatchUrl}" />
                            <Button Grid.Column="1"
                                    Classes="action-button"
                                    Width="130"
                                    IsEnabled="{Binding CanInstall}"
                                    Command="{Binding InstallCommand}"
                                    Background="#2563EB"
                                    Content="一键安装" />
                        </Grid>

                        <Grid Grid.Column="1"
                              IsVisible="{Binding UseLocalSource}"
                              ColumnDefinitions="*,130,130"
                              ColumnSpacing="12">
                            <TextBox Grid.Column="0"
                                     IsEnabled="{Binding CanInstall}"
                                     Watermark="请选择 zip / rar / 7z"
                                     Text="{Binding LocalPatchPath}" />
                            <Button Grid.Column="1"
                                    Classes="action-button"
                                    Width="130"
                                    IsEnabled="{Binding CanInstall}"
                                    Click="ManualSelectPatch"
                                    Background="#7C3AED"
                                    Content="... 重新选择补丁" />
                            <Button Grid.Column="2"
                                    IsVisible="{Binding ShowLocalInstallButton}"
                                    Classes="action-button"
                                    Width="130"
                                    IsEnabled="{Binding CanInstall}"
                                    Command="{Binding InstallCommand}"
                                    Background="#2563EB"
                                    Content="一键安装" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   Text="游戏目录" />
                        <TextBox Grid.Column="1"
                                 IsEnabled="{Binding CanInstall}"
                                 Text="{Binding GamePath}" />
                        <Button Grid.Column="2"
                                Classes="action-button"
                                Width="130"
                                IsEnabled="{Binding CanInstall}"
                                Click="ManualLocateGamePath"
                                Background="#374151"
                                Content="手动定位" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="18" Background="#1F2937" CornerRadius="14">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Text="安装进度" />
                        <TextBlock Grid.Column="1"
                                   Foreground="#D1D5DB"
                                   HorizontalAlignment="Right"
                                   Text="{Binding DownloadText}" />
                        <Button Grid.Column="2"
                                Classes="action-button"
                                Width="110"
                                IsVisible="{Binding CanCancelInstall}"
                                Command="{Binding CancelInstallCommand}"
                                Background="#DC2626"
                                Content="取消下载" />
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 Height="12"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding DownloadProgress}" />

                    <TextBlock Grid.Row="2"
                               Foreground="#A7F3D0"
                               Text="{Binding DownloadSpeedText}" />

                    <TextBlock Grid.Row="3"
                               Foreground="#93C5FD"
                               Text="{Binding StatusText}" />

                    <Grid Grid.Row="4" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Padding="12" Background="#111827" CornerRadius="10">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="White" FontWeight="SemiBold" Text="1. 获取补丁" />
                                <TextBlock Foreground="#D1D5DB" Text="{Binding Step1Status}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="12" Background="#111827" CornerRadius="10">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="White" FontWeight="SemiBold" Text="2. 解压补丁" />
                                <TextBlock Foreground="#D1D5DB" Text="{Binding Step2Status}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="12" Background="#111827" CornerRadius="10">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="White" FontWeight="SemiBold" Text="3. 覆盖安装" />
                                <TextBlock Foreground="#D1D5DB" Text="{Binding Step3Status}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" Padding="18" Background="#0B1220" CornerRadius="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <TextBlock Foreground="White"
                               FontWeight="SemiBold"
                               Text="安装日志" />
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <SelectableTextBlock Classes="log-entry"
                                                         Margin="0,0,0,6"
                                                         Text="{Binding .}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
